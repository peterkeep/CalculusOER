<exercises xml:id="ex-DivergenceTest">
    <exercise>
        <statement>
            <p>
                Give an example of a series that diverges due to the Divergence Test. Explain.
            </p>
        </statement>
    </exercise>
    <exercise>
        <statement>
            <p>
                Give an example of a series that fails the Divergence Test. Do you know if this series converges or diverges? Explain.
            </p>
        </statement>
    </exercise>
    <exercise>
        <introduction>
            <p>
                Apply the Divergence Test to each of the following series. Explain the conclusions of the test for each series.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    <m>\displaystyle\sum_{k=1}^\infty \left(\frac{k}{k^2+1}\right)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        \lim_k\to\infty \frac{k}{k^2+1} = 0
                    </md>
                    The Divergence Test is inconclusive.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle\sum_{k=1}^\infty \left(\frac{k}{e^k}\right)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        \lim_{k\to\infty} \frac{k}{e^k} = 0
                    </md>
                    The Divergence Test is inconclusive.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle\sum_{k=2}^\infty \left( \frac{1}{k\ln(k)} \right)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        \lim_{k\to\infty} \frac{1}{k\ln(k)} = 0
                    </md>
                    The Divergence Test is inconclusive.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle\sum_{k=2}^\infty \left(\frac{k}{\ln(k)}\right)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>\lim_{k\to\infty} \frac{k}{\ln(k)} = \infty
                    </md>
                    Since the limit is not 0, the series diverges.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle\sum_{k=1}^\infty \left(\sqrt[k]{k}\right)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        \lim_{k\to\infty} \sqrt[k]{k} = 1
                    </md>
                    Since the limit is not 0, the series diverges.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle\sum_{k=0}^\infty \left( \frac{k^2+k}{e^k} \right)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        \lim_{k\to\infty} \frac{k^2+k}{e^k} = 0
                    </md>
                    The Divergence Test is inconclusive.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle\sum_{k=1}^\infty \left( \frac{1}{k^2+1} \right)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        \lim_{k\to\infty} \frac{1}{k^2+1} = 0
                    </md>
                    The Divergence Test is inconclusive.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle\sum_{k=1}^\infty \left( \frac{k!}{k^2} \right)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        \lim_{k\to\infty} \frac{k!}{k^2} = \infty
                    </md>
                    The Divergence Test is inconclusive.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle\sum_{k=1}^\infty \left( \frac{(-1)^k(k+1)}{k+\frac{1}{k}} \right)</m>
                </p>
            </statement>
            <solution>
                <p>
                    Consider the limit of the positive terms:
                    <md>
                        \lim_{k\to\infty} \frac{k+1}{k+\frac{1}{k}} = 1
                    </md>
                    The limit of the terms oscillates between <m>1</m> and <m>-1</m>. But we can see that the limit of the terms is not <m>0</m>, and so the series diverges.
                </p>
            </solution>
        </task>
    </exercise>
</exercises>