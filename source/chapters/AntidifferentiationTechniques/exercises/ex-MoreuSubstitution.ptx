<exercises xml:id="ex-MoreuSubstitution">
    <exercise>
        <statement>
            <p>
                Why do we say that <m>u</m>-substitution undoes the Chain Rule? Explain how the process of our variable substitution accomplishes that.
            </p>
        </statement>
    </exercise>
    <exercise>
        <introduction>
            <p>
                For each of the following indefinite integrals, identify a useful substitution and antidifferentiate.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    <m>\displaystyle \int \frac{x^2+2}{x^3+6x-5}\;dx</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>\int \frac{x^2+2}{x^3+6x-5}\;dx \amp </mrow>
                        <mrow>u \amp = x^3+6x-5</mrow>
                        <mrow>du \amp = (3x^2+6)\;dx</mrow>
                        <mrow> \amp = 3(x^2+2)\;dx</mrow>
                        <mrow> \int \frac{x^2+2}{x^3+6x-5}\;dx \amp = \frac{1}{3}\int \frac{1}{u}\;du</mrow>
                        <mrow> \amp = \frac{1}{3}\ln|u|+C</mrow>
                        <mrow> \amp = \frac{1}{3}\ln|x^3+6x-5|+C</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle \int \sec(4x-1)\tan(4x-1)\;dx</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>\int \sec(4x-1)\tan(4x-1)\;dx \amp </mrow>
                        <mrow>u \amp = 4x-1</mrow>
                        <mrow>du \amp = 4\;dx</mrow>
                        <mrow>\int \sec(4x-1)\tan(4x-1)\;dx \amp = \frac{1}{4}\int \sec(u)\tan(u)\;du</mrow>
                        <mrow> \amp = \frac{\sec(u)}{4}+C</mrow>
                        <mrow> \amp = \frac{\sec(4x-1)}{4} + C</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle \int \left(\frac{x+5}{x-1}\right)\;dx</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>\int \left(\frac{x+5}{x-1}\right)\;dx \amp </mrow>
                        <mrow>u \amp = x-1 </mrow>
                        <mrow>du \amp = dx</mrow>
                        <mrow>x \amp = u+1</mrow>
                        <mrow>\int \left(\frac{x+5}{x-1}\right)\;dx \amp = \int \left(\frac{(u+1)+5}{u}\right)\;du</mrow>
                        <mrow> \amp = \int \left(\frac{u+6}{u}\right)\;du</mrow>
                        <mrow> \amp = \int 1 + \frac{6}{u}\;du</mrow>
                        <mrow> \amp = u + 6\ln|u|+C</mrow>
                        <mrow> \amp = x + 6\ln|x-1|+C</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle \int (x+5)\sqrt{x-1}\;dx</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>\int (x+5)\sqrt{x-1}\;dx \amp </mrow>
                        <mrow>u \amp = x-1 </mrow>
                        <mrow>du \amp = dx</mrow>
                        <mrow>x \amp = u+1</mrow>
                        <mrow>\int (x+5)\sqrt{x-1}\;dx \amp \int (u+1+5)\sqrt{u}\;du</mrow>
                        <mrow> \amp = \int (u+6)(u^{1/2})\;du</mrow>
                        <mrow> \amp = \int u^{3/2}+6u^{1/2}\;du</mrow>
                        <mrow> \amp = \frac{2u^{5/2}}{5} + 4u^{3/2}+C</mrow>
                        <mrow> \amp = \frac{2(x-1)^{5/2}}{5} + 4(x-1)^{3/2}+C</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle \int (x+5)^{51}(x-1)^2\;dx</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow> \int (x+5)^{51}(x-1)^2\;dx \amp </mrow>
                        <mrow>u \amp = x+5</mrow>
                        <mrow>du \amp = dx</mrow>
                        <mrow>x \amp = u-5</mrow>
                        <mrow>\int (x+5)^{51}(x-1)^2\;dx \amp = \int u^{51}(u-6)^2\;du</mrow>
                        <mrow> \amp = \int u^{51}(u^2-12u+36)\;du</mrow>
                        <mrow> \amp = \int u^{53} - 12u^{52} + 36u^{51}\;du</mrow>
                        <mrow> \amp = \frac{u^{54}}{54} - \frac{12u^{53}}{53} + \frac{9u^{52}}{13} + C</mrow>
                        <mrow> \amp = \frac{(x+5)^{54}}{54} - \frac{12(x+5)^{53}}{53} + \frac{9(x+5)^{52}}{13} + C</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle \int \frac{x+1}{\sqrt{x-3}}\;dx</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>\int \frac{x+1}{\sqrt{x-3}}\;dx \amp </mrow>
                        <mrow>u \amp = x-3</mrow>
                        <mrow>du \amp = dx</mrow>
                        <mrow>x \amp = u+3</mrow>
                        <mrow>\int \frac{x+1}{\sqrt{x-3}}\;dx  \amp = \int \frac{u+4}{\sqrt{u}}\;du </mrow>
                        <mrow> \amp = \int u^{1/2} + 4u^{-1/2}\;du</mrow>
                        <mrow> \amp = \frac{2u^{3/2}}{3} + 8u^{1/2}+C</mrow>
                        <mrow> \amp = \frac{2(x-3)^{3/2}}{3} + 8\sqrt{x-3} + C</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>\displaystyle \int \frac{1}{(x+2)\sqrt{x+1}}\;dx</m>
                </p>
            </statement>
            <hint>
                <p>
                    Don't multiply the denominator out.
                </p>
            </hint>
            <solution>
                <p>
                    <md>
                        <mrow>\int \frac{1}{(x+2)\sqrt{x+1}}\;dx \amp </mrow>
                        <mrow>u \amp = x+1</mrow>
                        <mrow>du \amp = dx</mrow>
                        <mrow>x \amp = u-1</mrow>
                        <mrow>\int \frac{1}{(x+2)\sqrt{x+1}}\;dx \amp = \int \frac{1}{(u+1)\sqrt{u}}\;du</mrow>
                        <mrow>t \amp = \sqrt{u}</mrow>
                        <mrow>dt \amp = \frac{1}{2\sqrt{u}}\;du</mrow>
                        <mrow>u \amp = t^2</mrow>
                        <mrow>\int \frac{1}{(u+1)\sqrt{u}}\;du \amp = 2\int \frac{1}{t^2+1}\;dt</mrow>
                        <mrow> \amp = 2\tan^{-1}(t) + C</mrow>
                        <mrow> \amp = 2\tan^{-1}(\sqrt{u}) + C</mrow>
                        <mrow> \amp = 2\tan^{-1}(\sqrt{x+1}) + C</mrow>
                    </md>
                </p>
            </solution>
        </task>
    </exercise>
</exercises>