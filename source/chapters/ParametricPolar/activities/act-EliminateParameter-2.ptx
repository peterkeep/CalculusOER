<activity xml:id="act-EliminiateParameter-2" xmlns:xsi="http://www.w3.org/2001/XInclude">
    <title>Eliminate More Parameters</title>
    <introduction>
        <p>
            For each parametrically-defined curve, eliminate the parameter to create a function <m>y=f(x)</m> or <m>x=f(y)</m>.
        </p>
        <p>
            Feel free to use the interactive graphing tool in <xref ref="act-EliminateParameter"/>.
        </p>
    </introduction>
    <task>
        <statement>
            <p>
                <m>\begin{array}{l}
                        x = t^2-1\\
                        y = (3t+1)^3
                    \end{array}
                </m> for <m>0 \leq t \leq 2</m>.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                <m>\begin{array}{l}
                        x = \ln(t+1)\\
                        y = \sin(t)
                    \end{array}
                </m> for <m>0 \leq t</m>.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                <m>\begin{array}{l}
                        x = \cos^2(t)\\
                        y = (t+1)^{3/2}
                    \end{array}
                </m> for <m>0 \leq t</m>.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                <m>\begin{array}{l}
                        x = \tan^{-1}(x)\\
                        y = t^2
                    \end{array}
                </m> for <m>-2 \leq t \leq 2</m>.
            </p>
        </statement>
    </task>
</activity>