<setup>
  <function name="f" variable="t">
    sin^2(t)
  </function>
  <number name="ang">pi/25</number>
</setup>

<p>
  <em>Instructions:</em> Move the slider to change <m>\theta_k^*</m> and move the point along the polar curve.
</p>


<slider name="t" initialValue="pi/3" from="0" to="2pi" step="0.001" showTicks="false"><label><m>\theta_k^*</m></label></slider>

<booleanInput name="showSlice">
  <label>Show the <m>k</m>th slice.</label>
</booleanInput>

<graph xMin="-1.1" xMax="1.1" yMax="1.1" yMin="-1.1" displayXAxisTicks="false" displayYAxisTicks="false" fixAxes>
  <shortDescription>
    A polar curve that has two loops, one at pi over 2 and another at 3 pi over 2. There is a point that moves around the curve. It has theta sub k star labeled, and when the checkbox is selected, there is a triangular sector from the center to the point. The interior angle is labeled delta theta and the distance from the origin to the point is labeled r of theta sub k star.
  </shortDescription>
  <!-- Grid -->
  <repeatForSequence from="0" to="6" step="1" valueName="k">
    <circle styleNumber="6" radius="$k" draggable="false"/>
  </repeatForSequence>
  <repeatForSequence from="0" to="6" step="1" valueName="k">
    <line through="(0,0) (cos($k*pi/6), sin($k*pi/6))" draggable="false" styleNumber="6"/>
  </repeatForSequence>
  <!-- Curve -->
  <curve parMin="0" parMax="2pi" variable="t">
    ($$f(t)*cos(t), $$f(t)*sin(t))
  </curve>
  <point name="P">
    ($$f($t)*cos($t), $$f($t)*sin($t))
  </point>
  <!-- Sector -->
  <curve parMin="$t-$ang" parMax="$t+$ang" variable="t" styleNumber="2" hide="!$showSlice">
    ($$f($t)*cos(t), $$f($t)*sin(t))
  </curve>
  <function name="sectL" domain="[0, $$f($t)*cos($t+$ang)]" styleNumber="2" hide="!$showSlice">sin($t+$ang) /cos($t+$ang)x</function>
  <function name="sectR" domain="[0, $$f($t)*cos($t-$ang)]" styleNumber="2" hide="!$showSlice">sin($t-$ang) /cos($t-$ang)x</function>
  <!-- Labels -->
  <lineSegment endpoints="(0,0) $P" lineStyle="dashed" endpointsDraggable="false" styleNumber="3"/>
  <label styleNumber="2" anchor="($P.x/3, $P.y/3)" maskLabel hide="!$showSlice"><m>\Delta \theta</m></label>
  <label anchor="(3$P.x/4+0.1, 3$P.y/4)" maskLabel styleNumber="3" hide="!$showSlice"><m>r(\theta_k^*)</m></label>
  <curve hide="$showSlice" parMin="0" parMax="$t" variable="t" styleNumber="3">
    ((0.15+0.01t)cos(t), (0.15+0.01t)sin(t))
  </curve>
  <label anchor="(0.25cos(2$t/3), 0.25sin(2$t/3))" styleNumber="3" maskLabel hide="$showSlice"><m>\theta_k^*</m></label>
</graph>

