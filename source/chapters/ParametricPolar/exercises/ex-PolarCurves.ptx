<exercises xml:id="ex-PolarCurves" xmlns:xi="http://www.w3.org/2001/XInclude">
    <exercise>
        <statement>
            <p>
                Explain how a curve written in polar coordinates is different than one written in Cartesian coordinates.
            </p>
        </statement>
    </exercise>
    <exercise>
        <introduction>
            <p>
                Convert the following Cartesian coordinates to polar coordinates.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    <m>(4,0)</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>(-5,5)</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>(3,-3)</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>(-\sqrt{3},-1)</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>(0,-3)</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>(-4,4\sqrt{3})</m>
                </p>
            </statement>
        </task>
    </exercise>
    <exercise>
        <statement>
            <p>
                For each point above, find a second, different, representation of the same point. Explain how you did this.
            </p>
        </statement>
    </exercise>
    <exercise>
        <statement>
            <p>
                Explain why there are an infinite number of possible polar coordinates corresponding with each pair of Cartesian coordinates above.
            </p>
        </statement>
    </exercise>
    <exercise>
        <introduction>
            <p>
                For each of the following polar curves, plot the curve in the graphing utility below. Then, find at least 5 different points on the polar curve, plot them, and describe the behavior of the curve.
            </p>
            <interactive platform="doenetml" width="95%" aspect="1:1">
                <slate surface="doenetml">
                    <xi:include parse="text" href="../doenet/ex-PolarGraphingUtility.doenet"/>
                </slate>
            </interactive>
        </introduction>
        <task>
            <statement>
                <p>
                    <m>r=\sin(\theta)+\cos(\theta)</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>r=\sin^2(\theta)</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>r=\cos(4\theta)+\theta</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>r=\sin^2(-\theta)</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>r=\theta^2\sin(\theta)</m>
                </p>
            </statement>
        </task>
    </exercise>
</exercises>