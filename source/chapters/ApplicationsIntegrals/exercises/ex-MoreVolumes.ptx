<exercises xml:id="ex-MoreVolumes">
    <exercise>
        <p>
            Consider the integral formula for computing volumes of a solid of revolution using the disk/washer method. What part of this integral formula represents the radius/radii of any circle(s)? Why is the radius represented using the function output from the curve(s) defining the region?
        </p>
    </exercise>
    <exercise>
        <p>
            Consider the integral formula for computing volumes of a solid of revolution using the shell method. What part of this integral formula represents the radius/radii of any circle(s)? Why is the radius not represented using the function output from the curve(s) defining the region?
        </p>
    </exercise>
    <exercise>
        <introduction>
            <p>
                For each of the solids described below, set up an integral expression using disks/washers representing the volume of the solid.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    The region bounded by the curve <m>y=1-\sqrt{x}</m> in the first quadrant, revolved around <m>x=2</m>.
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>V \amp = \pi \int_{y=0}^{y=0} (2)^2 - (2-(1-y^2))^2\;dy</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    The region bounded by the curve <m>y=1-\sqrt{x}</m> in the first quadrant, revolved around <m>x=-1</m>.
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>V \amp = \pi \int_{y=0}^{y=1} (1-y^2-(-1))^2 - (1)^2\;dy</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    The region bounded by the curve <m>y=1-\sqrt{x}</m> in the first quadrant, revolved around <m>y=-2</m>.
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>V \amp = \pi \int_{x=0}^{x=1} (1-\sqrt{x} - (-2))^2 - (-2)^2\;dx</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    The region bounded by the curve <m>y=1-\sqrt{x}</m> in the first quadrant, revolved around <m>y=3</m>.
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        V = \int_{x=0}^{x=1} (3)^2 - (3-(1-\sqrt{x}))^2\;dx
                    </md>
                    
                </p>
            </solution>
        </task>
    </exercise>
    <exercise>
        <introduction>
            <p>
                For each of the solids described below, set up an integral expression using shells representing the volume of the solid.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    The region bounded by the curves <m>y=\sqrt{x}</m> and <m>y=x</m> in the first quadrant, revolved around the line <m>x=2</m>.
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>V \amp = 2\pi \int_{x=0}^{x=1} (2-x)(1-\sqrt{x})\;dx</mrow>
                    </md>
                    
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    The region bounded by the curves <m>y=\sqrt{x}</m> and <m>y=x</m> in the first quadrant, revolved around the line <m>x=-1</m>.
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>V \amp = 2\pi \int_{x=0}^{x=1} (x-(-1))(1-\sqrt{x})\;dx</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    The region bounded by the curves <m>y=\sqrt{x}</m> and <m>y=x</m> in the first quadrant, revolved around the line <m>y=-2</m>.
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>V \amp = 2\pi \int_{y=0}^{y=1}(y+2)(1-y^2)\;dy</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    The region bounded by the curves <m>y=\sqrt{x}</m> and <m>y=x</m> in the first quadrant, revolved around the line <m>y=3</m>.
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        V = 2\pi \int_{y=0}^{y=1} (3-y)(1-y^2)\;dy
                    </md>
                    
                </p>
            </solution>
        </task>
    </exercise>
</exercises>