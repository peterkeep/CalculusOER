<exercises xml:id="ex-ArcLengthSurfaceArea">
    <exercise>
        <statement>
            <p>
                The formula for arc length of the function <m>f(x)</m> on the interval <m>[a,b]</m> is <m>\displaystyle L = \int_{x=a}^{x=b} \sqrt{1+f'(x)^2}\;dx</m>. Explain how this definition is built, using the slice-and-sum method. Make sure to explain how we the Pythagorean Theorem is involved.
            </p>
        </statement>
    </exercise>
    <exercise>
        <statement>
            <p>
                Why do we use <m>f'(x)</m> in the formula for arc length?
            </p>
        </statement>
    </exercise>
    <exercise>
        <introduction>
            <p>
                For each of the following curves on intervals, evaluate the arc length.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    <m>y = -6x+2 </m> on <m>[1,5]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = -6</mrow>
                        <mrow>\ell \amp = \int_{x=1}^{x=5} \sqrt{1+(-6)^2}\;dx</mrow>
                        <mrow> \amp = \int_{x=1}^{x=5} \sqrt{37}\;dx</mrow>
                        <mrow> \amp = \left(x\sqrt{37}\right)\bigg|_{x=1}^{x=5}</mrow>
                        <mrow> \amp = 4\sqrt{37}</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>y=\dfrac{x^{3/2}}{3}</m> on <m>[0,60]</m>
                </p>
            </statement>
            <mrow>y' \amp = \frac{x^{1/2}}{2}</mrow>
            <mrow>\ell \amp = \int_{x=0}^{x=60} \sqrt{1+\left(\frac{x^{1/2}}{2}\right)^2}\;dx</mrow>
            <mrow> \amp = \int_{x=0}^{x=60}\sqrt{1+\frac{x}{4}}\;dx</mrow>
            <mrow> \amp = \left(\frac{8\left(1+\frac{x}{4}\right)^{3/2}}{3}\right)\bigg|_{x=0}^{x=60}</mrow>
            <mrow> \amp = \frac{8(16)^{3/2}}{3}</mrow>
            <mrow> \amp = \frac{512}{3}</mrow>
        </task>
        <task>
            <statement>
                <p>
                    <m>y=\dfrac{x^4}{4}+ \dfrac{1}{8x^2}</m> on <m>[1,3]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = x^3 - \frac{1}{4x^3}</mrow>
                        <mrow>\ell \amp = \int_{x=1}^{x=3} \sqrt{1+ \left(x^3-\frac{1}{4x^3}\right)^2}\;dx</mrow>
                        <mrow> \amp = \int_{x=1}^{x=3} \sqrt{1 + \left(x^6 - \frac{1}{2} + \frac{1}{16x^6}\right)}\;dx</mrow>
                        <mrow> \amp = \int_{x=1}^{x=3} \sqrt{x^6 + \frac{1}{2} + \frac{1}{16x^6}}\;dx</mrow>
                        <mrow> \amp = \int_{x=1}^{x=3} x^3 + \frac{1}{4x^3}\;dx</mrow>
                        <mrow> \amp = \left( \frac{x^4}{4} - \frac{1}{8x^2} \right)\bigg|_{x=1}^{x=3}</mrow>
                        <mrow> \amp = 20 - \frac{1}{72} + \frac{1}{8}</mrow>
                    </md>
                </p>
            </solution>
        </task>
    </exercise>
    <exercise>
        <introduction>
            <p>
                For each of the following curves on intervals, set up an integral representing the arc length. Do not evaluate.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                   <m>y=\tan^2(x)</m> on <m>\left[-\frac{\pi}{4}, \frac{\pi}{4}\right]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = 2\tan(x)\sec^2(x)</mrow>
                        <mrow>\ell \amp = \int_{x=-\pi/4}^{x=\pi/4} \sqrt{1+4\tan^2(x)\sec^4(x)}\;dx</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                   <m>y=\ln(x^2)</m> on <m>[1, e]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = \frac{2}{x}</mrow>
                        <mrow>\ell \amp = \int_{x=1}^{x=e}\sqrt{1+\frac{4}{x^2}}\;dx</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                   <m>y = \sqrt{x+1}</m> on <m>[0,8]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = \frac{1}{2\sqrt{x+1}}</mrow>
                        <mrow>\ell \amp = \int_{x=0}^{x=8} \sqrt{1+\frac{1}{4x+4}}\;dx</mrow>
                    </md>
                </p>
            </solution>
        </task>
    </exercise>
    <exercise>
        <statement>
            <p>
                Why is the formula for arc length seemingly involved in the integral formula for surface area of a solid of revolution?
            </p>
        </statement>
    </exercise>
    <exercise>
        <statement>
            <p>
                In the integral formula <m>\displaystyle A = \int_{x=a}^{x=b} 2\pi f(x) \sqrt{1+f'(x)^2} \; dx</m>, what does <m>f(x)</m> represent? What about <m>2\pi</m>?
            </p>
        </statement>
    </exercise>
    <exercise>
        <introduction>
            <p>
                For each of the following curves and intervals, find the surface area of the solid formed when the curve is revolved around the <m>x</m>-axis.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    <m>y = 2x+3</m> on <m>[0,3]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = 2</mrow>
                        <mrow>A \amp = 2\pi\int_{x=0}^{x=3} (2x+3)\sqrt{5}\;dx</mrow>
                        <mrow> \amp = 2\pi\sqrt{5} \int_{x=0}^{x=3} (2x+3)\;dx</mrow>
                        <mrow> \amp = 2\pi\sqrt{5} \left( x^2+3x \right)\bigg|_{x=0}^{x=3}</mrow>
                        <mrow> \amp = 36\pi\sqrt{5}</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>y = 4\sqrt{x}</m> on <m>[4, 9]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = \frac{2}{\sqrt{x}}</mrow>
                        <mrow>A \amp = 2\pi\int_{x=4}^{x=9} 4\sqrt{x}\sqrt{1+\frac{4}{x}}\;dx</mrow>
                        <mrow> \amp = 8\pi \int_{x=4}^{x=9}\sqrt{x+4}\;dx</mrow>
                        <mrow> \amp = \frac{16\pi}{3}(x+4)^{3/2}\bigg|_{x=4}^{x=9}</mrow>
                        <mrow> \amp = \frac{16\pi}{3} \left( 13^{3/2} - 8^{3/2} \right)</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>y=\dfrac{x^4}{4}+ \dfrac{1}{8x^2}</m> on <m>[1,3]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = x^3 - \frac{1}{4x^3}</mrow>
                        <mrow>A \amp = 2\pi \int_{x=1}^{x=3} \left( \frac{x^4}{4} + \frac{1}{8x^2} \right) \sqrt{1+\left(x^3-\frac{1}{4x^3}\right)^2}\;dx</mrow>
                        <mrow> \amp = 2\pi \int_{x=1}^{x=3} \left( \frac{x^4}{4} + \frac{1}{8x^2} \right) \sqrt{1+ \left( x^6 - \frac{1}{2} + \frac{1}{16x^6} \right)}\;dx</mrow>
                        <mrow> \amp = 2\pi \int_{x=1}^{x=3} \left( \frac{x^4}{4} + \frac{1}{8x^2} \right) \sqrt{x^6 + \frac{1}{2} + \frac{1}{16x^6}}\;dx </mrow>
                        <mrow> \amp = 2\pi \int_{x=1}^{x=3} \left( \frac{x^4}{4} + \frac{1}{8x^2} \right) \left( x^3 + \frac{1}{4x^3}\right)\;dx</mrow>
                        <mrow> \amp = 2\pi \int_{x=1}^{x=3} \left( \frac{x^7}{4} + \frac{3x}{16} + \frac{1}{32x^5} \right)\;dx</mrow>
                        <mrow> \amp = 2\pi \left( \frac{x^8}{32} + \frac{3x^3}{64} - \frac{1}{160x^4} \right)\bigg|_{x=1}^{x=3}</mrow>
                        <mrow> \amp = 2\pi \left(205 + \frac{39}{32} - \frac{1}{3^4(160)} + \frac{1}{160}\right)</mrow>
                    </md>
                </p>
            </solution>
        </task>
    </exercise>
    <exercise>
        <introduction>
            <p>
                For each of the following curves and intervals, set up the surface area of the solid formed when the curve is revolved around the <m>x</m>-axis. Do not evaluate the integral.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    <m>y = \sin\left(e^{x^2}\right)+1</m> on <m>[0,2]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = 2xe^{x^2}\cos\left(e^{x^2}\right)</mrow>
                        <mrow>A \amp = 2\pi \int_{x=0}^{x=2} \left(\sin\left(e^{x^2}\right)+1\right) \sqrt{1 + \left(2xe^{x^2}\cos\left(e^{x^2}\right)\right)^2}\;dx</mrow>
                    </md>
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    <m>y = \ln(x^2)</m> on <m>[1,e]</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        <mrow>y' \amp = \frac{2}{x}</mrow>
                        <mrow>A \amp = 2\pi \int_{x=1}^{x=e} \ln(x^2)\sqrt{1+\frac{4}{x^2}}\;dx</mrow>
                    </md>
                </p>
            </solution>
        </task>
    </exercise>
</exercises>